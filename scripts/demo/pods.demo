# Pods: one daemon per pane, holding the PTY and the backlog.
cols 120
rows 30
speed 0.04
name pods

run hexe pod list
wait 3

# A pod with no session at all — a shell with a socket in front of it.
run hexe pod new --name notes
wait 2.5
run hexe pod list | tail -2
wait 3

# Talking to it from outside, with nobody attached.
run hexe pod send --name notes --enter "echo written from the CLI > /tmp/hexe-demo-work/notes.txt"
wait 2
run cat /tmp/hexe-demo-work/notes.txt
wait 2.5

run hexe pod kill --name notes; hexe pod gc --dry-run
wait 3
