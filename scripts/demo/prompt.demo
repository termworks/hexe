# The shell prompt: hexe renders it, and this shell asks for it directly.
cols 240
rows 60
speed 0.05
name prompt

# The prompt on screen is hexe's, drawn by the segments in the same config the
# status bar reads. oslo calls it from its own hooks rather than from a
# generated shell snippet.
run grep -n 'shp prompt' -A3 $HOME/.config/oslo/prompt.lua | head -12
wait 5

# Left segments, and a right prompt drawn on the same row.
run cd src
wait 2.5
run cd ..
wait 2.5

# The status segment shows what the last command did.
run false
wait 3
run true
wait 2.5

# The same renderer, called by hand.
run hexe shell prompt --status 1 --duration 1200 --jobs 2
wait 4
