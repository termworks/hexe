# Sprites: 1152 pokemon, drawn over a pane, for no reason at all.
cols 240
rows 60
speed 0.04
name sprite

run echo "a pane like any other"
wait 2

key C-M-p
wait 4

key C-M-h
wait 2.5
key C-M-p
wait 4

# Each pane keeps its own, and the sprite is the pane's own name.
key C-M-Left
wait 2
key C-M-p
wait 2.5
key C-M-p
wait 3.5
