# Floats: overlay panes with their own lifetime rules.
cols 240
rows 60
speed 0.04
name floats

run echo "a plain pane, underneath"
wait 1.8

# Alt+1: a float with a command in it. The pane below is still there.
key M-1
wait 4

# Toggling it away leaves the process running.
key M-1
wait 2.5

# Alt+2 is a different float — same keys, different instance and title.
key M-2
wait 4

# It moves.
key M-S-Left
wait 1.5
key M-S-Down
wait 2.5
key M-2
wait 2

# The explorer float is anchored right and is `navigatable`.
key C-M-9
wait 3.5
key C-M-9
wait 2

# per_cwd: the same key in another directory is another instance.
run cd /tmp/hexe-demo-work/other
wait 2
key M-1
wait 4
key M-1
wait 2
run cd /tmp/hexe-demo-work/proj
wait 2

# Back where it was, with its own scrollback.
key M-1
wait 3.5
key M-1
wait 2
