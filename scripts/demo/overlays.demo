# Overlays: everything hexe draws on top of the panes.
cols 240
rows 60
speed 0.04
name pop

# A notification: drawn over the bar, timed out, blocking nothing.
run hexe terminal notify "deploy finished"
wait 4

# The same thing from a key, as a desktop notification through the terminal.
key C-M-n
wait 3

# Pane select: every pane gets a letter, and the letter picks it.
key C-M-h
wait 3
key C-M-o
wait 3.5
key a
wait 3

# Keycast: the keys, on screen, for teaching and for films like this one.
key C-M-k
wait 2
key C-M-Left
wait 1.2
key C-M-Right
wait 1.2
key C-M-h
wait 2.5
key C-M-k
wait 2

# A question. The confirmations for quitting, detaching, disowning and closing
# are the same popup, turned on per action in `mux.confirm`.
key C-M-q
wait 4
key Enter
wait 4
