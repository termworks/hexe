# Overlays: everything hexe draws on top of the panes.
cols 240
rows 60
speed 0.035
name pop

run # a notification: drawn over the bar, timed out, blocking nothing
wait 2.5
run hexe terminal notify "deploy finished"
wait 4

run # to one pane, or to every pane at once
wait 2
run hexe terminal notify --broadcast "deploying to production"
wait 4

run # and from a key, which asks the host terminal for a desktop notification instead
wait 2.5
key C-M-n
wait 3

# ── pane select ─────────────────────────────────────────────────────────────
run # pane select puts a letter over every pane, drawn in block digits so it reads at a glance
wait 3
key C-M-h
wait 3
key C-M-e
wait 3
key C-M-o
wait 3.5
key a
wait 3

# ── keycast ─────────────────────────────────────────────────────────────────
run # keycast shows the last few chords, grouped by time — for teaching and for films like this
wait 3
key C-M-k
wait 2
key C-M-Left
wait 1.2
key C-M-Right
wait 1.2
key C-M-Down
wait 1.2
key C-M-m
wait 2
key C-M-m
wait 2
key C-M-k
wait 2.5

# ── sprites ─────────────────────────────────────────────────────────────────
run # and the pokemon overlay, which is the same machinery drawing something useless
wait 3
key C-M-p
wait 3.5
key C-M-p
wait 2.5

# ── questions ───────────────────────────────────────────────────────────────
run # a confirm is a question with the tab's keys held until it is answered
wait 3
key C-M-q
wait 4
key Enter
wait 4
