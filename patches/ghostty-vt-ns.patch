From: hexe
Subject: [PATCH] terminal: retain embedder-owned cell style state

hexe records which palette namespace was current when each cell was written, so
it can resolve indexed colours per namespace and recolour one program's output
without touching anything else on screen.

The tag is never interpreted by ghostty. It occupies bits that were already
padding inside Flags, so Style and its page layout remain unchanged. Sitting in
Flags also means it joins equality and hashing with no further changes, and a
tag of 0 behaves exactly as before.

The other three hunks all say one thing: the tag is embedder state, not terminal
state a program can clear. Each is a path that rewrites the cursor style
wholesale, and each would otherwise silently untag everything printed after it
-- with the embedder unable to notice, because it never sees the sequence that
did it.

  - SGR reset (ESC[0m), which programs emit constantly.
  - DECRC / cursor restore, which would additionally resurrect a selection the
    program had already released.
  - RIS / full reset, which reinitialises the screen. This one also re-interns,
    because assigning the style without that leaves style_id at the default and
    the cells written next carry a tag of 0 whatever the flag says.

OSC 1331 uses one byte of Style's existing trailing padding for each interned
foreground mix percentage. Style remains 28 bytes on the supported target,
Cell remains 8 bytes, and Page remains 376 bytes. The percentage participates
in equality and consumes eight bits of PackedStyle's existing padding. Its
default of 100 is ordinary opaque output.
---
--- a/src/terminal/style.zig
+++ b/src/terminal/style.zig
@@ -27,6 +27,8 @@
     /// a packed struct to make this take up significantly less space.
     flags: Flags = .{},
-
+
+    fg_mix_percent: u8 = 100,
+
     const Flags = packed struct(u16) {
         bold: bool = false,
         italic: bool = false,
@@ -37,7 +39,14 @@
         strikethrough: bool = false,
         overline: bool = false,
         underline: sgr.Attribute.Underline = .none,
-        _padding: u5 = 0,
+
+        /// Opaque namespace tag owned by the embedder, never interpreted here.
+        ///
+        /// Lives in bits that were already padding, so Style keeps its size and
+        /// its page layout. Because it sits in Flags it joins equality and
+        /// hashing for free: cells written under different tags keep distinct
+        /// interned styles, and a tag of 0 is byte-identical to before.
+        ns: u5 = 0,
     };
 
     /// The color for an SGR attribute. A color can come from multiple
@@ -94,6 +103,7 @@
     /// True if the style is equal to another style.
     pub fn eql(self: Style, other: Style) bool {
-        return self.flags == other.flags and
+        return self.fg_mix_percent == other.fg_mix_percent and
+            self.flags == other.flags and
             self.fg_color.eql(other.fg_color) and
             self.bg_color.eql(other.bg_color) and
             self.underline_color.eql(other.underline_color);
@@ -475,7 +485,8 @@
             underline: Data,
         },
         flags: Flags,
-        _padding: u16 = 0,
-
+        fg_mix_percent: u8,
+        _padding: u8 = 0,
+
         /// After https://github.com/ziglang/zig/issues/19754 is implemented,
         /// it will be an compiler-error to have packed union fields of
@@ -519,6 +530,7 @@
                     .underline = .fromColor(style.underline_color),
                 },
                 .flags = style.flags,
+                .fg_mix_percent = style.fg_mix_percent,
             };
         }
     };
--- a/src/terminal/Screen.zig
+++ b/src/terminal/Screen.zig
@@ -340,12 +340,23 @@
     assert(cursor_pin.x == 0);
     assert(cursor_pin.y == 0);
     const cursor_rac = cursor_pin.rowAndCell();
+    // The embedder's namespace tag survives a reset: it tracks the embedder's
+    // own selection, not terminal state a program can reset. Without this, RIS
+    // silently untags everything printed after it, and the embedder cannot
+    // notice because it never sees the sequence.
+    const live_ns = self.cursor.style.flags.ns;
+    const live_fg_mix_percent = self.cursor.style.fg_mix_percent;
     self.cursor.deinit(self.alloc);
     self.cursor = .{
         .page_pin = cursor_pin,
         .page_row = cursor_rac.row,
         .page_cell = cursor_rac.cell,
     };
+    self.cursor.style.flags.ns = live_ns;
+    self.cursor.style.fg_mix_percent = live_fg_mix_percent;
+    // Re-intern: assigning the style alone leaves style_id at the default, so
+    // the cells written next would carry a tag of 0 whatever the flag says.
+    if (live_ns != 0 or live_fg_mix_percent != 100) self.manualStyleUpdate() catch {};
 
     if (comptime build_options.kitty_graphics) {
         // Reset kitty graphics storage
@@ -1811,7 +1822,14 @@
 
     switch (attr) {
         .unset => {
+            // The embedder's namespace tag is not an SGR attribute, so a reset
+            // must not clear it. Programs emit ESC[0m constantly; clearing here
+            // would drop the tag on every cell written after the first reset.
+            const ns = self.cursor.style.flags.ns;
+            const fg_mix_percent = self.cursor.style.fg_mix_percent;
             self.cursor.style = .{};
+            self.cursor.style.flags.ns = ns;
+            self.cursor.style.fg_mix_percent = fg_mix_percent;
         },
 
         .bold => {
--- a/src/terminal/Terminal.zig
+++ b/src/terminal/Terminal.zig
@@ -1008,8 +1008,17 @@
         .charset = .{},
     };
 
-    // Set the style first because it can fail
+    // Set the style first because it can fail.
+    //
+    // The embedder's namespace tag is deliberately NOT restored: it tracks the
+    // embedder's own selection, not the program's saved SGR state. Restoring it
+    // would resurrect a selection the program had already released, and stamp
+    // whatever it printed next with someone else's namespace.
+    const live_ns = self.screens.active.cursor.style.flags.ns;
+    const live_fg_mix_percent = self.screens.active.cursor.style.fg_mix_percent;
     self.screens.active.cursor.style = saved.style;
+    self.screens.active.cursor.style.flags.ns = live_ns;
+    self.screens.active.cursor.style.fg_mix_percent = live_fg_mix_percent;
     self.screens.active.manualStyleUpdate() catch |err| {
         // Regardless of the error here, we revert back to an unstyled
         // cursor. It is more important that the restore succeeds in
